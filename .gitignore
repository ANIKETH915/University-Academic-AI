# ==============================================================================
# University Academic AI RAG - Professional GitIgnore
# ==============================================================================

# Python Byte-compiled / Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# Environment & Secret Files (Never commit real API keys or secrets)
.env
.env.*
!.env.example
frontend/.env

# Virtual Environments
.venv/
venv/
env/
ENV/

# Node & Frontend Dependencies / Builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded User Data & Runtime PDF Collections (Local data — DO NOT COMMIT)
data/uploads/
data/pyq/
data/tmp/

# Vector Storage & Cache (Regenerated dynamically via ingestion)
chroma_db/

# Local Restore Snapshots & Diagnostics
_restore_points/
scratch/restore_points/
out.txt
real_pdf_audit.json
tests/evaluation/evaluation_report.json
tests/evaluation/evaluation_report.md

# Temporary & Log Files
tmp/
temp/
logs/

# IDE & OS Specific Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
