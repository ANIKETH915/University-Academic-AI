# ---------------------------------------------------------------------------
# Universal PYQ Intelligence — environment template
#
# Copy to .env and fill in the values you actually use.
# NEVER commit .env. NEVER put real keys in this file.
#
# The LLM is optional. With no keys configured the system still runs the full
# deterministic + OCR extraction pipeline; it simply skips LLM assistance.
# ---------------------------------------------------------------------------

# Primary provider: openai | gemini | groq | openrouter | none
LLM_PROVIDER=openai

# Fallback order tried when the primary provider fails.
# Leave unset to use the built-in order: openai,gemini,groq,openrouter
LLM_FALLBACK_PROVIDERS=gemini,groq,openrouter

# Per-request timeout and bounded retries for transient failures
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Provider credentials (leave blank for providers you do not use) -------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Legacy single-provider configuration (still honoured) -----------------
# LLM_API_KEY=
# LLM_MODEL=

# --- Test isolation --------------------------------------------------------
# Set by the test suite so pytest never touches production data.
# WORKSPACE_DB_TEST_MODE=1
# PYQRAG_TEST_COLLECTION=pyqrag_pytest_collection
